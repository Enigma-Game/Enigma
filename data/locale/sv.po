msgid "Third stone from the rock is the hole!"
msgstr "Den tredje stenen från klippan är hålet!"

#: level_i18n.cc:922
msgid "is  black  always  beautiful?"
msgstr "är  svart  alltid  vackert?"

#: level_i18n.cc:926
msgid "So,  where  are  the  knights?  -  you'll  be  sorry  you  asked!"
msgstr "Så,  var  är  riddarna?  -  du  kommer  att  ångra  att  du  frågade!"

