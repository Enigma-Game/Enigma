msgstr "Låt den vita kulan vänta på korset i 3 sekunder."

#: level_i18n.cc:4778
msgid "All is Rubble"
msgstr "Allt är bråte"

#: level_i18n.cc:4782
msgid "Meandering Impulses"
msgstr "Slingrande impulser"

#: level_i18n.cc:4810
msgid "Enigmas wildcat"
msgstr "Enigmas vildkatt"

#: level_i18n.cc:4893
msgid "No clear view? How about visiting an optician?"
msgstr "Ser du dåligt? Vad sägs om ett besök hos optikern?"

#: level_i18n.cc:4901
